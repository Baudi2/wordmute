/* ============================================================
   WordMute — Models tab regroup, LIGHT theme (QSS)
   ------------------------------------------------------------
   Same selectors and metrics as wordmute-models.qss — colors only.
   Load order: wordmute-light.qss + wordmute-setup-light.qss +
   wordmute-0.6.1-light.qss + this file.
   ============================================================ */

QFrame#group_device, QFrame#group_models, QFrame#group_service {
  background: #f8f9ff; border: 1px solid #cfd3e5; border-radius: 10px;
}
QLabel[groupTitle="true"] { font-size: 13px; font-weight: 600; color: #292b31; }
QLabel[groupHint="true"]  { font-size: 11px; color: #595d6c; }

QLabel#device_icon {
  min-width: 28px; max-width: 28px; min-height: 28px; max-height: 28px;
  border-radius: 8px; qproperty-alignment: AlignCenter;
  background: #e7e5fe; border: 1px solid #d2cefd;
}
QLabel#device_text { font-size: 13px; color: #292b31; }
QLabel#device_note { font-size: 12px; color: #595d6c; }
QFrame#group_device[state="warn"] { border-color: rgba(165,129,60,0.45); }
QFrame#group_device[state="warn"] QLabel#device_text { color: #7a5f2b; }
QFrame#group_device[state="warn"] QLabel#device_icon {
  background: rgba(165,129,60,0.10); border-color: rgba(165,129,60,0.45);
}
QToolButton#device_settings_link {
  background: transparent; border: none; color: #5d5294; font-size: 12px; padding: 0;
}
QToolButton#device_settings_link:hover { text-decoration: underline; }

QLabel[tableCap="true"] {
  font-size: 10px; letter-spacing: 1px; color: #595d6c;
  border-bottom: 1px solid #dfe3f3; padding: 4px 10px;
}
QLabel[tableHead="true"] { font-size: 11px; color: #595d6c; padding: 0 10px; }

QFrame[modelRow="true"] {
  background: transparent; border: none; border-bottom: 1px solid #dfe3f3;
  min-height: 44px; max-height: 44px;
}
QFrame[modelRow="true"][state="busy"] { background: #eef0fb; }
QLabel#model_name  { font-size: 13px; color: #292b31; }
QLabel#model_state { font-size: 12px; color: #595d6c; }
QLabel#model_state[state="done"] { color: #292b31; }
QLabel#model_state[state="busy"] { color: #5d5294; }
QLabel#model_state[state="err"]  { color: #b05656; }
QLabel#model_size  { font-size: 12px; color: #595d6c; qproperty-alignment: 'AlignRight|AlignVCenter'; }
QLabel#model_size[state="done"] { color: #292b31; }
QProgressBar#model_progress { max-height: 3px; border-radius: 2px; background: #dfe3f3; border: none; }
QProgressBar#model_progress::chunk { background: #9184d9; border-radius: 2px; }

QPushButton#model_download {
  background: transparent; border: 1px solid #cfd3e5; border-radius: 5px;
  color: #292b31; font-size: 11px; padding: 6px 14px;
}
QPushButton#model_download:hover { background: #dfe3f3; border-color: #b2b6ca; }
QPushButton#model_cancel {
  background: transparent; border: 1px solid #cfd3e5; border-radius: 5px;
  color: #595d6c; font-size: 11px; padding: 6px 12px;
}
QPushButton#model_cancel:hover { background: #dfe3f3; color: #292b31; }
QToolButton#model_more {
  background: transparent; border: 1px solid #cfd3e5; border-radius: 6px;
  color: #595d6c; font-size: 14px;
  min-width: 30px; max-width: 30px; min-height: 30px; max-height: 30px;
}
QToolButton#model_more:hover { border-color: #b2b6ca; color: #292b31; }
QToolButton#model_more::menu-indicator { image: none; }
QPushButton#model_download:disabled, QPushButton#model_cancel:disabled,
QToolButton#model_more:disabled { color: rgba(41,43,49,0.35); border-color: #dfe3f3; }

QWidget#disk_summary { background: transparent; border-top: 1px solid #dfe3f3; }
QLabel#disk_total { font-size: 12px; color: #292b31; }
QLabel[diskLegend="true"] { font-size: 11px; color: #595d6c; }
QFrame[diskSeg="components"] { background: #b3a9e6; border: none; }
QFrame[diskSeg="whisper"]    { background: #9184d9; border: none; }
QFrame[diskSeg="gigaam"]     { background: #d2cefd; border: none; }
QFrame[diskDot="components"], QFrame[diskDot="whisper"], QFrame[diskDot="gigaam"] {
  min-width: 7px; max-width: 7px; min-height: 7px; max-height: 7px; border-radius: 2px;
}
QFrame[diskDot="components"] { background: #b3a9e6; }
QFrame[diskDot="whisper"]    { background: #9184d9; }
QFrame[diskDot="gigaam"]     { background: #d2cefd; }

QPushButton#btn_check[mode="check"] {
  background: transparent; border: 1px solid #cfd3e5; border-radius: 6px;
  color: #292b31; font-size: 12px; padding: 6px 13px;
}
QPushButton#btn_check[mode="check"]:hover { background: #dfe3f3; }
QPushButton#btn_check[mode="update"] {
  background: #e7e5fe; border: 1px solid #9184d9; border-radius: 6px;
  color: #5d5294; font-size: 12px; padding: 6px 13px;
}
QPushButton#btn_check[mode="update"]:hover { background: #d2cefd; }
QLabel#upd_checked_at { font-size: 11px; color: #595d6c; }

QFrame[updateRow="true"] {
  background: #f3f5fe; border: 1px solid #cfd3e5; border-radius: 6px;
  min-height: 36px; max-height: 36px;
}
QFrame[updateRow="true"][state="new"] { border-color: #9184d9; }
QFrame[updateRow="true"][state="err"] { border-color: rgba(176,86,86,0.55); }
QLabel#upd_icon { min-width: 12px; max-width: 12px; qproperty-alignment: AlignCenter; }
QLabel#upd_name { font-size: 12px; color: #292b31; }
QLabel#upd_old  { font-size: 12px; color: #595d6c; }
QLabel#upd_new  { font-size: 12px; color: #5d5294; }
QLabel#upd_state { font-size: 11px; color: #595d6c; }
QLabel#upd_state[state="err"] { color: #b05656; }
QPushButton#upd_row_btn {
  background: transparent; border: 1px solid #cfd3e5; border-radius: 5px;
  color: #292b31; font-size: 11px; padding: 5px 12px;
}
QPushButton#upd_row_btn:hover { background: #dfe3f3; }
QPushButton#upd_row_btn[accent="true"] { border-color: #9184d9; color: #5d5294; }
QPushButton#upd_row_btn[accent="true"]:hover { background: #e7e5fe; }
QToolButton#upd_whats_new {
  background: transparent; border: none; color: #5d5294; font-size: 11px; padding: 0;
}
QToolButton#upd_whats_new:hover { text-decoration: underline; }
QProgressBar#upd_progress { max-height: 3px; border-radius: 2px; background: #dfe3f3; border: none; }
QProgressBar#upd_progress::chunk { background: #9184d9; border-radius: 2px; }
QLabel#upd_footnote { font-size: 11px; color: #595d6c; }

QWidget#svc_footer { background: transparent; border-top: 1px solid #dfe3f3; }
QPushButton#btn_component_install {
  background: transparent; border: 1px solid #cfd3e5; border-radius: 6px;
  color: #292b31; font-size: 12px; padding: 7px 14px;
}
QPushButton#btn_component_install:hover { background: #dfe3f3; border-color: #b2b6ca; }
QLabel#svc_hint { font-size: 11px; color: #595d6c; }
QToolButton#btn_repair_link {
  background: transparent; border: none; color: #b05656; font-size: 11px; padding: 0;
}
QToolButton#btn_repair_link:hover { text-decoration: underline; }
QLabel#svc_repair_hint { font-size: 11px; color: #595d6c; }

/* local merge: the tab scrolls as a whole — its three groups outgrow a
   760px window once the update list is filled */
QScrollArea#models_scroll { background: transparent; border: none; }
QScrollArea#models_scroll > QWidget > QWidget { background: transparent; }

/* local merge: fixes from the first live run
   - the state cell's container is a bare QWidget and picked up a
     styled background — the «Состояние» column showed as a band
   - the base sheets' QPushButton min-height/padding and QToolButton
     padding inflated the row buttons past the 44px row and the ⋯
     button past its 30x30 spec */
QWidget#model_state_box { background: transparent; }
QToolButton#model_more { padding: 0; }
QPushButton#model_download, QPushButton#model_cancel,
QPushButton#upd_row_btn { min-height: 0; }
